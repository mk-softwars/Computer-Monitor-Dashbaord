{
  "name": "computer-monitor-dashboard-desktop",
  "version": "1.0.0",
  "description": "Local real-time Windows hardware monitoring dashboard",
  "author": "Mohammed",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json && electron-builder",
    "build:web": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.computermonitor.dashboard",
    "productName": "Computer Monitor Dashbaord",
    "directories": {
      "output": "../artifacts/release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../artifacts/monitor",
        "to": "monitor"
      },
      {
        "from": "../LICENSE",
        "to": "licenses/Computer-Monitor-Dashboard-MIT.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../licenses",
        "to": "licenses/third-party"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": ["nsis"]
    },
    "nsis": {
      "artifactName": "Computer-Monitor-Dashbaord-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
